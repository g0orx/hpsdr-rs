# udev rule for non-root USB access to RTL2832U "RTL-SDR" dongles (e.g.
# NooElec NESDR Smart, 0bda:2838) -- one line per VID:PID in rtlsdr.rs's
# KNOWN_DEVICES (itself librtlsdr's known_devices[] table), same
# "standard permission rule" reasoning as 90-ozy.rules.
#
# No need to blacklist the dvb_usb_rtl28xxu kernel module: hpsdr-rs
# detaches it when it opens the dongle.
#
# Install: copy to /etc/udev/rules.d/, then either replug the device or
# run: sudo udevadm control --reload-rules && sudo udevadm trigger
# Generic RTL2832U
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0bda",ATTRS{idProduct}=="2832",MODE="666"
# Generic RTL2832U OEM
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0bda",ATTRS{idProduct}=="2838",MODE="666"
# DigitalNow Quad DVB-T PCI-E card
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0413",ATTRS{idProduct}=="6680",MODE="666"
# Leadtek WinFast DTV Dongle mini D
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0413",ATTRS{idProduct}=="6f0f",MODE="666"
# Genius TVGo DVB-T03 USB dongle (Ver. B)
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0458",ATTRS{idProduct}=="707f",MODE="666"
# Terratec Cinergy T Stick Black (rev 1)
SUBSYSTEMS=="usb",ATTRS{idVendor}=="0ccd",ATTRS{idProduct}=="00a9",MODE="666"
# Terratec NOXON DAB/DAB+ USB dongle (rev 1)
